{
  "expo": {
    "name": "Orion",
    "slug": "mobile",
    "scheme": "orion",
    "version": "2.1.10",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07070C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.okali.orion",
      "versionCode": 12
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07070C",
          "image": "./assets/brand-mark.png",
          "imageWidth": 96,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Orion to access your camera to scan the desktop pairing QR code."
        }
      ],
      "expo-notifications",
      "expo-video",
      "./plugins/withOrionNsd",
      "./plugins/withOrionCinemaWebView",
      "./plugins/withOrionGoogleIdentity",
      "./plugins/withOrionGoogleDriveAuthorization",
      "./plugins/withOrionUpdates",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "db8d113f-2d08-4a1c-b58a-19dceeeca94f"
      }
    },
    "runtimeVersion": "orion-mobile-native-r1",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "useEmbeddedUpdate": true
    }
  }
}
