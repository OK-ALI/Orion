# Orion build-time configuration
# Use a TMDB API Read Access Token (Bearer token), not the short API key.
VITE_TMDB_READ_TOKEN=replace_with_your_tmdb_read_access_token

# Optional local-development fallbacks used only by Electron's main process.
# These private provider keys are NOT included in public release packages.
ORION_WYZIE_API_KEY=replace_with_your_wyzie_api_key
ORION_SUBDL_API_KEY=replace_with_your_subdl_api_key

# Google backup/sync uses Orion's centrally managed Desktop OAuth client.
# The installed-app flow uses PKCE, state verification and Google's Desktop
# client credential during authorization-code and refresh-token exchange.
ORION_GOOGLE_CLIENT_ID=replace_with_your_google_client_id.apps.googleusercontent.com
ORION_GOOGLE_CLIENT_SECRET=replace_with_your_google_desktop_client_secret
