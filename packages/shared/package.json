{
  "name": "@orion/shared",
  "version": "1.0.0",
  "description": "Orion shared library — design tokens, types, API clients, and source registry",
  "license": "GPL-3.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./tokens/*": "./src/tokens/*.ts",
    "./types": "./src/types/index.ts",
    "./api": "./src/api/index.ts",
    "./api/*": "./src/api/*.ts",
    "./sources": "./src/sources/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
